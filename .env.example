# Copy to .env and fill locally. Never paste secrets into chat or commit .env.
POSTGRES_USER=gitstargram
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=gitstargram
DATABASE_URL=postgresql+asyncpg://gitstargram:change-this-local-password@db:5432/gitstargram
REDIS_URL=redis://redis:6379/0
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_API_VERSION=2026-03-10
SESSION_SECRET=replace-with-a-random-64-character-secret
COOKIE_SECURE=false
AI_BASE_URL=http://host.docker.internal:8001/v1
AI_MODEL_NAME=Qwen/Qwen3.5-4B
EMBEDDING_BASE_URL=http://host.docker.internal:8002/v1
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSIONS=1024
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=

